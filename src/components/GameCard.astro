---
const { title, price, img_url, slug } = Astro.props;
---

<a href={`/juegos/${slug}`} class="card-link">
  <article class="game-card">
    <div class="image-container">
      <img src={img_url} alt={title} class="game-img" />
    </div>
    <div class="info">
      <h3>{title}</h3>
      <p class="price">${price.toFixed(2)}</p>
      <button class="buy-btn">COMPRAR KEY</button>
    </div>
  </article>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%; /* Asegura que ocupe el ancho del grid */
  }

  .game-card {
    background-color: #111821; /* El color de tu navbar */
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    height: 100%;
    max-width: 250px; /* Limitamos el ancho para que no crezcan de más */
    margin: 0 auto;
  }

  /* EFECTO HOVER: Levanta y pone el borde lila de tu captura */
  .game-card:hover {
    transform: translateY(-10px);
    border-color: #7c4dff; 
    box-shadow: 0 10px 20px rgba(124, 77, 255, 0.2);
  }

  .image-container {
    width: 100%;
    aspect-ratio: 2/3; /* Mantiene la proporción de poster de juego */
    overflow: hidden;
  }

  .game-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    padding: 1rem; /* Reducido de 1.5rem para que sea más compacto */
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  h3 {
    font-size: 1rem; /* Reducido de 1.2rem para mejor ajuste */
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis; /* Si el título es muy largo, no rompe la card */
  }

  .price {
    color: #2de29d; /* El verde neón de Supabase/Captura */
    font-size: 1.3rem; /* Ajustado de 1.5rem */
    font-weight: 800;
  }

  .buy-btn {
    background-color: #5e35b1; /* El morado base que tenías */
    color: white;
    border: none;
    padding: 0.6rem; /* Más delgado */
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 0.3rem;
    font-size: 0.8rem;
  }
</style>