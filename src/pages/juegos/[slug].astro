---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const { slug } = Astro.params;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: juego, error } = await supabase
  .from('Games')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !juego) {
  return Astro.redirect('/404');
}
---

<Layout title={`Wiki | ${juego.title}`}>
  <div class="wiki-container">
    
    <div class="main-content">
      <!-- LADO IZQUIERDO: Portada + Compra -->
      <div class="sidebar">
        <div class="poster-area">
          <img src={juego.img_url} alt={juego.title} />
        </div>
        
        <!-- Contenedor para alinear precio y botón lado a lado -->
        <div class="purchase-row">
          <div class="price-box">${juego.price.toFixed(2)}</div>
          <button class="buy-button">COMPRAR KEY</button>
        </div>
      </div>

      <!-- LADO DERECHO: Título + Descripción Estilizada -->
      <div class="details-area">
        <h1 class="game-title">{juego.title}</h1>
        <div class="description-text">
          <p>{juego.description || "Sin descripción disponible."}</p>
        </div>
      </div>
    </div>

    <!-- TRAILER ABAJO -->
    {juego.video_id && (
      <div class="trailer-container">
        <iframe 
          src={`https://www.youtube.com/embed/${juego.video_id}`}
          title="YouTube video player" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>
    )}
  </div>
</Layout>

<style>
  .wiki-container {
    max-width: 1100px;
    margin: 3rem auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    color: white;
    font-family: 'Inter', sans-serif; /* Fuente más moderna */
  }

  .main-content {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* BARRA LATERAL */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .poster-area img {
    width: 100%;
    border-radius: 15px;
    border: 3px solid #7c4dff; 
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  /* NUEVA FILA DE COMPRA (Lado a lado) */
  .purchase-row {
    display: flex;
    gap: 0.8rem;
    align-items: stretch;
  }

  .price-box {
    flex: 1; /* Ocupa menos espacio */
    border: 2px solid #2de29d;
    color: #2de29d;
    text-align: center;
    padding: 0.6rem;
    border-radius: 10px;
    font-size: 1.2rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .buy-button {
    flex: 2; /* El botón es más ancho que el precio */
    background: #5e35b1;
    color: white;
    border: none;
    padding: 0.6rem;
    border-radius: 10px;
    font-weight: bold;
    font-size: 0.85rem;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .buy-button:hover {
    filter: brightness(1.2);
    transform: translateY(-2px);
  }

  /* CONTENIDO DERECHO ESTILIZADO */
  .game-title {
    font-size: 3.5rem;
    margin: 0 0 1.5rem 0;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -1px;
  }

  .description-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #e2e8f0;
    max-width: 65ch; /* Mejora la legibilidad */
    text-align: justify;
  }

  /* TRAILER */
  .trailer-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .trailer-container iframe {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 800px) {
    .main-content { grid-template-columns: 1fr; }
    .sidebar { max-width: 320px; margin: 0 auto; }
    .game-title { text-align: center; font-size: 2.5rem; }
    .description-text { text-align: center; }
  }
</style>