---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import { createClient } from '@supabase/supabase-js';

// Inicializamos el cliente de Supabase con tus credenciales del .env
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// Hacemos la consulta a la tabla 'Games' que vimos en tu base de datos
const { data: juegos, error } = await supabase
  .from('Games')
  .select('*');

if (error) {
  console.error('Error al conectar con Supabase:', error.message);
}
---

<Layout title="DARLIOS | Catálogo">
  <section class="catalogo-container">
    <div class="grid-juegos">
      {juegos && juegos.map((juego) => (
        <GameCard 
          title={juego.title} 
          price={juego.price} 
          img_url={juego.img_url} 
          slug={juego.slug} 
        />
      ))}
    </div>
    
    {(!juegos || juegos.length === 0) && !error && (
      <p class="loading">Cargando el arsenal de juegos...</p>
    )}
  </section>
</Layout>

<style>
  .catalogo-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .grid-juegos {
  display: grid;
  /* Bajamos de 280px a 220px para que entren más por fila */
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
  gap: 2rem; /* Espacio un poco más cerrado */
  padding: 2rem;
  max-width: 1100px; /* Acotamos el ancho total del catálogo */
  margin: 0 auto;
  }

  .loading {
    text-align: center;
    font-size: 1.5rem;
    margin-top: 4rem;
    opacity: 0.7;
  }
</style>
